# PeoplePay585 Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/peoplepay585

# JWT
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_NAME=PeoplePay585
APP_VERSION=1.0.0
DEBUG=true
